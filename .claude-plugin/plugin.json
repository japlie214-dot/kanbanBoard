{
  "$schema": "https://www.schemastore.org/claude-code-plugin-manifest.json",
  "name": "kanban-board",
  "version": "2.3.0",
  "description": "Kanban task tracking with dual-mode MCP isolation, PreToolUse hooks, and independent kb-qa gating.",
  "author": {
    "name": "kanbanBoard",
    "url": "https://github.com/kanbanBoard"
  },
  "mcpServers": {
    "kanban": {
      "command": "python",
      "args": ["${CLAUDE_PLUGIN_ROOT}/mcp_server.py", "--mode", "work"]
    }
  }
}

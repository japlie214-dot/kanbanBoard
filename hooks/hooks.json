{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__.*__kanban_qa|Write|Edit|MultiEdit|NotebookEdit|Read|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.py\" --client claude",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}

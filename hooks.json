{
  "kanban-qa-guard": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content|view_file|run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python C:/Projects/kanbanBoard/hooks/guard.py --client antigravity",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
